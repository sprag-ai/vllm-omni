ARG BASE_IMAGE=vllm/vllm-openai:v0.32.0
FROM ${BASE_IMAGE}

ARG COMMON_WORKDIR=/app

WORKDIR ${COMMON_WORKDIR}

# Step 1: Setup - Install system dependencies
RUN apt-get update && \
    apt-get install -y git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${COMMON_WORKDIR}/vllm-omni

# Step 2: Copy vllm-omni code and install
# setup.py pins the package version to this when set; the build context carries no git tags.
ARG VLLM_OMNI_VERSION_OVERRIDE
COPY . ${COMMON_WORKDIR}/vllm-omni
RUN cd ${COMMON_WORKDIR}/vllm-omni && uv pip install --python "$(python3 -c 'import sys; print(sys.executable)')" --no-cache-dir "."

RUN ln -sf /usr/bin/python3 /usr/bin/python

# The server VAD only reads its pinned Silero model from the HF cache, so offline pods need it baked in.
RUN python3 -c "import hashlib; \
from huggingface_hub import hf_hub_download; \
from vllm_omni.engine.duplex.vad import SILERO_VAD_FILENAME, SILERO_VAD_REPO_ID, SILERO_VAD_REVISION, SILERO_VAD_SHA256; \
path = hf_hub_download(SILERO_VAD_REPO_ID, SILERO_VAD_FILENAME, revision=SILERO_VAD_REVISION); \
digest = hashlib.sha256(open(path, 'rb').read()).hexdigest(); \
assert digest == SILERO_VAD_SHA256, f'{path}: sha256 {digest}'"

ENTRYPOINT []
